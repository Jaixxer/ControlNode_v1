# Copy this file to config.yaml and fill in your own values.
# config.yaml is gitignored, so secrets stay local.

database:
  # Path to the SQLite file. Created if it does not exist.
  path: "./dev.db"

pki:
  # Directory the certificates are written to and read from.
  pkiRootPath: "/tmp/ctl/"
  caCertPath: "caCert.crt"
  caKeyPath: "caKey.key"
  serverCertPath: "serverCert.crt"
  serverKeyPath: "serverKey.key"

github:
  # OAuth app client ID, used by the device flow (`ctl auth github`).
  clientId: ""
  # The GitHub App ID, which is NOT the same as clientId above.
  appId: 0
  appSlug: ""
  # Path to the GitHub App's PEM private key, used to sign app JWTs.
  privateKeyPath: ""
  # HMAC secret used to verify X-Hub-Signature-256 on incoming webhooks.
  webhookSecret: ""
  # Public URL GitHub delivers webhooks to.
  webhookUrl: "https://your-public-host/github/webhook"
